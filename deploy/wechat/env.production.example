APP_ENV=production
AUTH_MODE=wechat_api
LOG_LEVEL=INFO
WECHAT_APP_ID=wx26dfe00bf5f3258b
WECHAT_APP_SECRET=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
WECHAT_CLOUD_ENV_ID=
