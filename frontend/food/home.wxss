@import "../../styles/common.wxss";

/* ============================================================
   饮食页
   ============================================================ */

.food-calendar {
  color: var(--green-dark);
  font-size: 34rpx;
  font-weight: 700;
}

/* ============ 今日摄入热量卡片（圆环版） ============ */
.intake-card {
  padding: 32rpx 28rpx;
  background: var(--surface);
  border-radius: 28rpx;
}

.intake-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.intake-copy {
  flex: 1;
  min-width: 0;
}

.intake-copy .muted {
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.intake-total {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.1;
  white-space: nowrap;
}

.intake-total .muted {
  font-size: 24rpx;
  font-weight: 500;
}

.intake-foot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.calorie-ring {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  padding: 14rpx;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 360ms cubic-bezier(0.2, 0, 0, 1);
}

.ring-center {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ring-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--green-dark);
  line-height: 1.1;
}

.ring-label {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.4;
}

/* ============ 饮食评分卡片 ============ */
.analysis-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 26rpx;
  background: var(--surface);
  border-radius: 28rpx;
}

.analysis-left {
  flex: none;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-right: 24rpx;
  border-right: 1rpx solid var(--line);
  box-sizing: border-box;
}

.analysis-left .muted {
  font-size: 22rpx;
}

.analysis-score {
  margin-top: 10rpx;
  font-size: 76rpx;
  font-weight: 800;
  color: var(--green-dark);
  line-height: 1;
}

.score-unit {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 500;
  margin-left: 4rpx;
}

.analysis-tag {
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 22rpx;
  font-weight: 600;
}

.analysis-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.analysis-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-green { background: var(--green); }
.dot-yellow { background: var(--yellow); }
.dot-orange { background: var(--orange); }

.analysis-row-copy {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.row-title {
  font-size: 24rpx;
  color: var(--ink-soft);
}

.row-status {
  font-size: 23rpx;
  color: var(--green-dark);
  font-weight: 600;
}

.analysis-tip {
  padding: 16rpx 8rpx 0;
  line-height: 1.55;
}

/* ============ 快速记录 ============ */
.quick-input-wrap {
  position: relative;
  margin-top: 20rpx;
}

.quick-input {
  width: 100%;
  height: 84rpx;
  padding: 0 84rpx 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface-low);
  box-sizing: border-box;
  font-size: 26rpx;
}

.quick-camera {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  color: var(--green-dark);
  opacity: 0.8;
}

/* ============ 生成一餐入口 ============ */
.generate-entry {
  min-height: 116rpx;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid var(--mint-strong);
  background: var(--green-soft);
  border-radius: 24rpx;
  text-align: left;
  box-shadow: none;
}

.generate-mark {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface);
  font-size: 36rpx;
  line-height: 1;
}

.generate-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.generate-copy text + text {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 400;
}

.generate-arrow {
  color: var(--green-dark);
  font-size: 44rpx;
  line-height: 1;
}

/* ============ 今日饮食列表 ============ */
.meal-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  white-space: nowrap;
  font-weight: 700;
}

.meal-add {
  color: var(--green-dark);
  font-size: 36rpx;
  font-weight: 400;
}

.page-body > .row-between .section-title {
  margin-bottom: 0;
}