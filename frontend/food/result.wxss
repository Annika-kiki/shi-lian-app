@import "../../styles/common.wxss";

/* ============================================================
   食谱列表页
   ============================================================ */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--canvas);
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-body {
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* ============ 顶部 ============ */
.header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  margin-bottom: 12rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  background: var(--surface-high);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-soft);
  padding: 0;
  min-width: auto;
}

.header-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  text-align: center;
}

.refresh-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  background: var(--surface-high);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--green-dark);
}

/* ============ 摘要 ============ */
.result-summary {
  padding: 4rpx 2rpx 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ============ 食谱卡片 ============ */
.recipe-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 4rpx 14rpx var(--shadow);
}

.recipe-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.recipe-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.3;
}

.recipe-kcal {
  flex: none;
  color: var(--green-dark);
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  white-space: nowrap;
}

.recipe-kcal text {
  margin-left: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 500;
}

.recipe-line {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 2rpx;
}

/* 标签 */
.recipe-tags {
  margin-top: 14rpx;
  gap: 10rpx;
}

.recipe-tags .pill {
  min-height: 44rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  background: var(--green-soft);
  color: var(--green-dark);
}

/* ============ 空状态 ============ */
.empty-state {
  padding: 58rpx 28rpx;
  text-align: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.empty-title {
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.empty-action {
  margin-top: 28rpx;
}