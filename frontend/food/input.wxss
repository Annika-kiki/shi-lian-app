@import "../../styles/common.wxss";

/* ============================================================
   输入食材页
   ============================================================ */

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--canvas);
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page-body {
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* ============ 顶部标题 ============ */
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  margin-bottom: 8rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  background: var(--surface-high);
  border-radius: 18rpx;
  font-size: 36rpx;
  color: var(--ink-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.header-tip {
  display: block;
  margin-bottom: 28rpx;
  padding-left: 80rpx;
  color: var(--muted);
  font-size: 24rpx;
}

/* ============ 区块 ============ */
.section {
  margin-bottom: 28rpx;
}

.section .section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

/* ============ 已有食材药丸 ============ */
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 180ms ease;
}

.pill-active {
  background: var(--green);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(78, 157, 67, 0.25);
}

.pill:active {
  transform: scale(0.96);
}

/* 已有食材药丸（带 × 号） */
.chip {
  background: var(--green-soft);
  color: var(--green-dark);
}

.chip-x {
  font-size: 26rpx;
  color: var(--green-dark);
  opacity: 0.7;
  margin-left: 2rpx;
}

/* ============ 输入框 ============ */
.input-box {
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--surface-low);
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
}

/* ============ AI 说明卡片 ============ */
.ai-note {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  background: var(--surface-low);
  border: 1rpx solid var(--line);
  box-shadow: none;
}

/* ============ 底部固定按钮 ============ */
.bottom-bar {
  flex: none;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
  box-shadow: 0 -4rpx 16rpx rgba(28, 47, 31, 0.05);
  box-sizing: border-box;
}

.btn-generate {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 2rpx;
}