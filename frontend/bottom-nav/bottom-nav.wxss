.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: #f7f2e8;
  border-top: 2rpx solid #ddd5c3;
  padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 20;
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #82958c;
  font-size: 24rpx;
}

.item.active {
  color: #4f8168;
}

.icon {
  font-size: 30rpx;
  line-height: 1;
}

.label {
  font-size: 24rpx;
  line-height: 1.2;
}
