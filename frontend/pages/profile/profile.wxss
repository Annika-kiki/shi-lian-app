@import "../../styles/common.wxss";

.gender {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-soft);
  border: 2rpx solid var(--line);
  box-shadow: none;
}

.input-box {
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: var(--surface);
  color: var(--ink);
  border: 2rpx solid var(--line);
  box-shadow: inset 0 0 0 2rpx rgba(56, 142, 60, 0.025);
}

.gender.pill-active {
  border-color: var(--green);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(56, 142, 60, 0.16);
}

.input-like {
  font-size: 34rpx;
  font-weight: 700;
}
