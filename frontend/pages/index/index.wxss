@import "../../styles/common.wxss";

.page-body {
  padding-top: 100rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 42rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 44rpx;
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 72rpx;
  box-shadow: 0 18rpx 34rpx rgba(47, 125, 61, 0.2);
}

.logo-leaf {
  transform: rotate(-8deg);
}

.brand-title {
  font-size: 50rpx;
  font-weight: 800;
}

.brand-subtitle {
  color: var(--muted);
  font-size: 28rpx;
}

.hero {
  height: 380rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--mint);
  border-color: var(--mint-strong);
}

.hero-orbit {
  width: 230rpx;
  height: 230rpx;
  border: 4rpx solid var(--green);
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
}

.hero-figure {
  width: 122rpx;
  height: 122rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  color: #fff;
  font-size: 58rpx;
}

.hero-dot {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #f7c84b;
}

.dot-one {
  top: 28rpx;
  right: 28rpx;
}

.dot-two {
  bottom: 28rpx;
  left: 28rpx;
  background: #ff8a3d;
}

.hero-copy {
  margin-top: 24rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.agreement {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 28rpx;
}
