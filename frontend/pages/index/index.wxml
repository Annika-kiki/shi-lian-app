<view class="page">
  <view class="page-body">
    <view class="brand">
      <view class="logo"><text class="logo-leaf">⌣</text></view>
      <text class="brand-title">食练周期</text>
      <text class="brand-subtitle">记录每一次训练，吃好每一餐</text>
    </view>

    <view class="hero card">
      <view class="hero-orbit">
        <view class="hero-dot dot-one"></view>
        <view class="hero-dot dot-two"></view>
        <view class="hero-figure">✦</view>
      </view>
      <view class="hero-copy">今天也要好好照顾自己</view>
    </view>

    <view class="btn" bindtap="goProfile">微信一键登录</view>
    <view class="spacer-24"></view>
    <view class="btn btn-outline" bindtap="skip">暂不填写资料</view>

    <view class="agreement" bindtap="toggleAgreement">
      <checkbox checked="{{agreed}}" color="#4f8168" />
      <text>我确认已满14周岁，并已阅读并同意</text>
      <text class="agreement-link" catchtap="viewTerms">《用户协议》</text>
      <text>和</text>
      <text class="agreement-link" catchtap="viewPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>
