.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: #f5f7f4;
}

.section,
.danger-section {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.title,
.danger-title {
  margin-bottom: 24rpx;
  color: #223027;
  font-size: 34rpx;
  font-weight: 600;
}

.paragraph {
  margin-bottom: 20rpx;
  color: #58625c;
  font-size: 28rpx;
  line-height: 1.7;
}

.danger-section {
  margin-top: 32rpx;
}

.delete-button {
  color: #b8322a;
  border: 1rpx solid #e4b7b3;
  background: #fff8f7;
  font-size: 28rpx;
}
