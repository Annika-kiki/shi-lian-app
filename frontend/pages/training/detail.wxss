@import "../../styles/common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.exercise-cover {
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--green-soft);
  border: 2rpx solid var(--line);
  box-shadow: none;
}

.cover-image {
  width: 100%;
  height: 380rpx;
  display: block;
}

.step {
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--ink-soft);
}
