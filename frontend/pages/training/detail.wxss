@import "../../styles/common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.video-card {
  overflow: hidden;
  border-radius: 32rpx;
}

.video {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #8bb39a;
}

.step {
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #425851;
}
