@import "../../styles/common.wxss";

.search-box {
  width: 100%;
  height: 100rpx;
  border-radius: 24rpx;
  border: 2rpx solid #d8cfbe;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #fffdf8;
  font-size: 30rpx;
}

.exercise-main { display: flex; align-items: center; gap: 20rpx; }
.exercise-thumb { width: 128rpx; height: 88rpx; border-radius: 16rpx; flex-shrink: 0; background: #f3eee3; }
