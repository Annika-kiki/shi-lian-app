@import "../../styles/common.wxss";

.list-body { padding-top: 38rpx; }
.list-header { display: grid; grid-template-columns: 72rpx 1fr 72rpx; align-items: center; margin-bottom: 30rpx; }
.back-button { width: 68rpx; height: 68rpx; border: 1rpx solid rgba(23,59,49,.16); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #173b31; font-size: 48rpx; }
.list-heading { text-align: center; }
.list-kicker { display: block; color: #9a8065; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.list-title { margin-top: 5rpx; font-size: 38rpx; font-weight: 800; color: #173b31; }
.search-shell { height: 94rpx; padding: 0 24rpx; border-radius: 18rpx; display: flex; align-items: center; gap: 16rpx; background: #fffdf7; }
.search-mark { color: #65766e; font-size: 34rpx; }
.search-box { height: 100%; min-width: 0; flex: 1; font-size: 28rpx; }
.search-clear { width: 48rpx; color: #86918c; text-align: center; font-size: 32rpx; }
.filter-track { display: flex; gap: 14rpx; padding-right: 32rpx; }
.pill { flex: none; padding: 13rpx 24rpx; border: 1rpx solid rgba(23,59,49,.14); background: transparent; font-size: 24rpx; }
.pill-active { border-color: #173b31; background: #173b31; color: #fff; }
.result-count { margin: 30rpx 0 12rpx; color: #7a8781; font-size: 22rpx; }
.exercise-results { border-top: 1rpx solid rgba(23,59,49,.14); }
.exercise-row { min-height: 158rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid rgba(23,59,49,.14); }
.exercise-thumb { width: 148rpx; height: 108rpx; flex: none; border-radius: 14rpx; display: block; background: #e7e4da; }
.exercise-info { min-width: 0; flex: 1; }
.exercise-title { overflow: hidden; color: #173b31; font-size: 29rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.tag-row { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.mini-tag, .level-tag { padding: 5rpx 10rpx; border-radius: 6rpx; background: #ebe6da; color: #69766f; font-size: 19rpx; }
.level-tag { background: #e2eadb; color: #40604e; }
.row-arrow { color: #8c9993; font-size: 40rpx; }
.empty-state { padding: 100rpx 20rpx; text-align: center; }
.empty-title { color: #173b31; font-size: 30rpx; font-weight: 700; }
.empty-copy { margin-top: 12rpx; color: #819089; font-size: 24rpx; }
