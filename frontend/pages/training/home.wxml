<view class="page">
  <view class="page-body">
    <view class="header">
      <view>
        <text class="header-subtitle">今天练什么？</text>
        <view class="header-title">训练</view>
      </view>
      <view class="icon-btn">⌕</view>
    </view>

    <view class="card card-soft card-pad">
      <view class="muted">今日建议</view>
      <view class="spacer-24"></view>
      <view class="item-title">{{summary.focus}}</view>
      <view class="item-meta">{{summary.moves}} 个动作 · 约 {{summary.minutes}} 分钟</view>
      <view class="spacer-24"></view>
      <view class="btn" bindtap="openRecent">开始训练</view>
    </view>

    <view class="spacer-24"></view>
    <view class="row-between">
      <text class="section-title">定制计划</text>
      <text class="muted">{{plan.goalName}}</text>
    </view>
    <view class="card card-pad plan-card">
      <view class="item-title">{{plan.title}}</view>
      <view class="item-meta">{{plan.description}}</view>
      <view class="plan-rule">{{plan.resistance}}</view>
    </view>

    <view class="spacer-24"></view>
    <view class="list">
      <block wx:for="{{plan.exercises}}" wx:key="id">
        <view class="list-item exercise-row" data-id="{{item.id}}" bindtap="openPlanExercise">
          <image class="exercise-thumb" src="{{item.coverSrc}}" mode="aspectFill" />
          <view class="exercise-copy">
            <view class="item-title">{{item.name}}</view>
            <view class="item-meta">{{item.meta}}</view>
            <view class="item-meta">{{item.dose}}</view>
            <view class="plan-note">{{item.notes}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="spacer-24"></view>
    <view class="card card-pad cardio-card" bindtap="openCardio">
      <view class="row-between">
        <view class="section-title">有氧安排</view>
        <view class="cardio-action">记录</view>
      </view>
      <view class="item-meta">{{plan.cardio.summary}}</view>
      <view class="plan-note">{{plan.cardio.notes}}</view>
    </view>

    <view class="spacer-24"></view>
    <text class="section-title">按部位查找</text>
    <view class="grid-3">
      <block wx:for="{{bodyParts}}" wx:key="part">
        <view class="card card-pad part-card" data-part="{{item.part}}" bindtap="openList">
          <view class="part-icon">{{item.icon}}</view>
          <view class="part-label">{{item.label}}</view>
        </view>
      </block>
    </view>

    <view class="spacer-24"></view>
    <view class="row-between">
      <text class="section-title">最近训练</text>
      <text class="muted" bindtap="openList" data-part="all">全部 ></text>
    </view>
    <view class="list-item" bindtap="openRecent">
      <view class="row-between">
        <view>
          <view class="item-title">{{summary.recent.title}}</view>
          <view class="item-meta">{{summary.recent.detail}}</view>
        </view>
        <view class="item-title">{{summary.recentDate}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showCardioModal}}" class="modal-mask" catchtap="closeCardio">
    <view class="modal-card" catchtap="noop">
      <view class="row-between">
        <view class="section-title">记录有氧</view>
        <view class="icon-btn modal-close" bindtap="closeCardio">×</view>
      </view>
      <view class="item-title">{{plan.cardio.mode}}</view>
      <view class="item-meta">{{plan.cardio.summary}}</view>
      <textarea class="cardio-input cardio-textarea" value="{{cardioInput}}" bindinput="onCardioInput" maxlength="255" placeholder="例如：蛙泳40分钟，或坡度10速度5.5 10分钟 坡度11速度5.5 20分钟"></textarea>
      <view class="plan-note">{{cardioEstimateText}}</view>
      <view class="btn" bindtap="saveCardio">{{savingCardio ? "保存中..." : "保存有氧"}}</view>
    </view>
  </view>

  <bottom-nav active="/pages/training/home" current="/pages/training/home" bind:change="onBottomNav" />
</view>
