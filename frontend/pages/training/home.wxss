@import "../../styles/common.wxss";

.training-page { background: #f4f1e8; color: #173b31; }
.training-body { padding: 44rpx 32rpx 190rpx; }
.training-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 34rpx; }
.eyebrow, .section-kicker { display: block; color: #8a775e; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-title { margin-top: 8rpx; font-size: 52rpx; line-height: 1.15; font-weight: 800; letter-spacing: -2rpx; }
.week-badge { width: 92rpx; height: 92rpx; border: 2rpx solid rgba(23,59,49,.2); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.week-number { font-size: 30rpx; font-weight: 800; line-height: 1; }
.week-label { margin-top: 6rpx; font-size: 18rpx; color: #6f7c76; }
.hero-card { padding: 34rpx; overflow: hidden; border-radius: 28rpx; background: #173b31; color: #fff; box-shadow: 0 18rpx 42rpx rgba(23,59,49,.16); }
.hero-topline { display: flex; align-items: center; justify-content: space-between; }
.hero-kicker { font-size: 24rpx; color: #b9cbbf; }
.goal-tag { padding: 9rpx 18rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 999rpx; font-size: 22rpx; }
.hero-title { width: 86%; margin: 32rpx 0; font-size: 44rpx; line-height: 1.25; font-weight: 800; }
.hero-meta { display: flex; align-items: center; margin-bottom: 32rpx; }
.meta-block { min-width: 130rpx; display: flex; flex-direction: column; }
.meta-value { max-width: 170rpx; overflow: hidden; color: #fff; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.meta-label { margin-top: 5rpx; color: #a9bbb1; font-size: 20rpx; }
.meta-line { width: 1rpx; height: 48rpx; margin: 0 24rpx; background: rgba(255,255,255,.18); }
.hero-action { height: 88rpx; padding: 0 28rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: space-between; background: #d8ef9f; color: #173b31; font-size: 30rpx; font-weight: 800; }
.action-arrow { font-size: 38rpx; font-weight: 400; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 52rpx 0 22rpx; }
.section-title-clean { margin-top: 7rpx; font-size: 36rpx; font-weight: 800; }
.section-count, .text-action { color: #718078; font-size: 24rpx; }
.exercise-list { border-top: 1rpx solid rgba(23,59,49,.14); }
.exercise-row-new { min-height: 142rpx; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid rgba(23,59,49,.14); }
.exercise-number { width: 42rpx; flex: none; color: #9b8b74; font-size: 20rpx; font-weight: 700; }
.exercise-image { width: 126rpx; height: 92rpx; flex: none; border-radius: 14rpx; background: #e7e4da; }
.exercise-copy { min-width: 0; flex: 1; }
.exercise-name { overflow: hidden; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.exercise-dose { margin-top: 8rpx; overflow: hidden; color: #728079; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { color: #8c9993; font-size: 40rpx; font-weight: 300; }
.cardio-strip { margin-top: 26rpx; padding: 24rpx; display: flex; align-items: center; gap: 20rpx; border-radius: 20rpx; background: #e5dcc9; }
.cardio-mark { width: 76rpx; height: 76rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #c96443; color: #fff; font-size: 22rpx; font-weight: 800; }
.cardio-copy { min-width: 0; flex: 1; }
.cardio-title { font-size: 28rpx; font-weight: 800; }
.cardio-meta { margin-top: 7rpx; overflow: hidden; color: #6f6658; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.cardio-add { width: 58rpx; height: 58rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fffaf0; font-size: 32rpx; }
.body-section-head { margin-bottom: 18rpx; }
.part-scroll { width: calc(100% + 32rpx); }
.part-track { display: flex; gap: 16rpx; padding-right: 32rpx; }
.part-tile { width: 154rpx; height: 174rpx; padding: 20rpx; flex: none; border-radius: 18rpx; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; background: #fffdf7; }
.part-code { color: #a19078; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; text-transform: uppercase; }
.part-name { font-size: 30rpx; font-weight: 800; }
.recent-head { margin-top: 48rpx; }
.recent-row { padding: 26rpx 0; display: flex; align-items: center; gap: 24rpx; border-top: 1rpx solid rgba(23,59,49,.14); border-bottom: 1rpx solid rgba(23,59,49,.14); }
.recent-date { width: 86rpx; color: #9a765e; font-size: 22rpx; line-height: 1.3; }
.recent-copy { min-width: 0; flex: 1; }
.recent-title { font-size: 28rpx; font-weight: 700; }
.recent-meta { margin-top: 8rpx; overflow: hidden; color: #718078; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.modal-mask { position: fixed; inset: 0; z-index: 40; padding: 32rpx; display: flex; align-items: flex-end; box-sizing: border-box; background: rgba(14,35,29,.52); }
.modal-card { width: 100%; padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 18rpx 18rpx; background: #f8f4ea; box-sizing: border-box; }
.modal-handle { width: 74rpx; height: 7rpx; margin: 0 auto 26rpx; border-radius: 8rpx; background: #c8c2b5; }
.modal-close { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; }
.cardio-preset { margin-top: 26rpx; color: #6f7c76; font-size: 24rpx; line-height: 1.5; }
.cardio-input { width: 100%; height: 160rpx; margin: 20rpx 0 16rpx; padding: 22rpx; border: 1rpx solid #d7d0c1; border-radius: 16rpx; background: #fffdf8; box-sizing: border-box; font-size: 28rpx; }
.estimate-text { min-height: 66rpx; color: #64736c; font-size: 23rpx; line-height: 1.45; }
.primary-button { height: 92rpx; margin-top: 18rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #173b31; color: #fff; font-size: 29rpx; font-weight: 800; }
