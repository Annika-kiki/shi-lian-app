@import "../../styles/common.wxss";

.part-card {
  min-height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.part-icon {
  font-size: 42rpx;
}

.part-label {
  font-size: 28rpx;
  font-weight: 700;
}

.plan-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.plan-rule,
.plan-note {
  font-size: 26rpx;
  line-height: 1.55;
  color: #53665d;
}

.exercise-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
}

.exercise-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #dfeedd;
  display: block;
}

.exercise-copy {
  min-width: 0;
}

.cardio-card .section-title {
  display: block;
  margin-bottom: 12rpx;
}

.cardio-card {
  position: relative;
}

.cardio-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f2ea;
  color: #4f8b6f;
  font-size: 24rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: rgba(31, 44, 39, 0.32);
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fffcf4;
  box-shadow: 0 18rpx 50rpx rgba(31, 44, 39, 0.18);
  box-sizing: border-box;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  font-size: 34rpx;
}

.cardio-input {
  width: 100%;
  min-height: 148rpx;
  margin: 28rpx 0 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d9dfd2;
  border-radius: 18rpx;
  background: #fffef9;
  color: #233c34;
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.cardio-textarea {
  display: block;
}
