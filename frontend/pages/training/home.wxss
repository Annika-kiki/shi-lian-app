@import "../../styles/common.wxss";

.part-card {
  min-height: 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}

.part-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 28rpx;
  font-weight: 800;
}

.part-label {
  font-size: 28rpx;
  font-weight: 700;
}

.plan-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: var(--surface);
}

.plan-rule,
.plan-note {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--muted);
}

.exercise-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
}

.exercise-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 22rpx;
  background: var(--mint);
  display: block;
}

.exercise-copy {
  min-width: 0;
}

.cardio-card .section-title {
  display: block;
  margin-bottom: 12rpx;
}

.cardio-card {
  position: relative;
  border-color: var(--mint-strong);
}

.cardio-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 24rpx;
  font-weight: 700;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 32rpx;
  background: var(--scrim);
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  padding: 32rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: var(--surface);
  box-shadow: 0 18rpx 50rpx rgba(25, 51, 29, 0.18);
  box-sizing: border-box;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  font-size: 34rpx;
}

.cardio-input {
  width: 100%;
  min-height: 160rpx;
  margin: 28rpx 0 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface-low);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.cardio-textarea {
  display: block;
}
