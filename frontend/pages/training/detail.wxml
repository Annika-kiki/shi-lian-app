<view class="page detail-page">
  <scroll-view class="page-scroll" scroll-y="true">
    <view class="detail-body">
      <view class="exercise-cover">
        <image
          class="cover-image"
          src="{{detail.coverSrc}}"
          mode="aspectFit"
        />
        <view class="floating-nav">
          <view class="float-button" bindtap="goBack">‹</view>
          <view class="float-button" bindtap="toggleFavorite">{{favorite ? '♥' : '♡'}}</view>
        </view>
      </view>

      <view class="detail-content">
        <text class="detail-kicker">EXERCISE GUIDE</text>
        <view class="detail-title">{{exercise.title}}</view>
        <view class="detail-tags"><text>{{detail.part}}</text><text>主要 {{detail.main}}</text><text>辅助 {{detail.assist}}</text></view>

      <view class="content-section">
        <view class="section-heading">动作步骤</view>
        <block wx:for="{{detail.steps}}" wx:key="index">
          <view class="step"><view class="step-number">{{index + 1}}</view><view class="step-copy">{{item}}</view></view>
        </block>
      </view>

      <view class="safety-card">
        <text class="safety-label">安全提示</text>
        <text class="safety-copy">{{detail.notes}}</text>
      </view>
      </view>
      <view class="detail-footer-space"></view>
    </view>
  </scroll-view>
  <view class="sticky-action"><view class="start-button" bindtap="startRecord"><text>开始记录</text><text>→</text></view></view>
</view>
