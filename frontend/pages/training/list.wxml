<view class="page">
  <view class="page-body">
    <view class="header">
      <view class="icon-btn" bindtap="onBottomNav" data-route="/pages/training/home">←</view>
      <text class="header-title">{{title}}</text>
      <view class="icon-btn">筛</view>
    </view>

    <input class="search-box" placeholder="搜索动作或器械" bindinput="onSearch" />

    <view class="spacer-24"></view>
    <view class="pill-row">
      <block wx:for="{{equipmentTabs}}" wx:key="*this">
        <view class="pill {{equipment === item ? 'pill-active' : ''}}" data-value="{{item}}" bindtap="setEquipment">{{item}}</view>
      </block>
    </view>

    <view class="spacer-24"></view>
    <view class="list">
      <block wx:for="{{filteredExercises}}" wx:key="id">
        <view class="list-item" data-id="{{item.id}}" bindtap="openDetail">
          <view class="row-between">
            <view>
              <view class="item-title">{{item.title}}</view>
              <view class="item-meta">{{item.muscle}} · {{item.equipment}} · {{item.level}}</view>
            </view>
            <view class="item-title">{{item.icon}} ></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <bottom-nav active="/pages/training/home" current="/pages/training/list" bind:change="onBottomNav" />
</view>
