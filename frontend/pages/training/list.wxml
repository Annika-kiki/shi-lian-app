<view class="page">
  <view class="page-body list-body">
    <view class="list-header">
      <view class="back-button" bindtap="goBack">‹</view>
      <view class="list-heading"><text class="list-kicker">EXERCISE LIBRARY</text><view class="list-title">{{title}}</view></view>
      <view class="header-space"></view>
    </view>

    <view class="search-shell">
      <text class="search-mark">⌕</text>
      <input class="search-box" value="{{keyword}}" placeholder="搜索动作、肌群或器械" bindinput="onSearch" />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</text>
    </view>

    <view class="spacer-24"></view>
    <scroll-view scroll-x="true" show-scrollbar="false">
    <view class="filter-track">
      <block wx:for="{{equipmentTabs}}" wx:key="*this">
        <view class="pill {{equipment === item ? 'pill-active' : ''}}" data-value="{{item}}" bindtap="setEquipment">{{item}}</view>
      </block>
    </view></scroll-view>

    <view class="spacer-24"></view>
    <view class="result-count">{{filteredExercises.length}} 个动作</view>
    <view class="exercise-results">
      <block wx:for="{{filteredExercises}}" wx:key="id">
        <view class="exercise-row" data-id="{{item.id}}" bindtap="openDetail">
          <image class="exercise-thumb" src="{{item.coverSrc}}" mode="aspectFit" />
          <view class="exercise-info">
            <view>
              <view class="exercise-title">{{item.title}}</view>
              <view class="tag-row"><text class="mini-tag">{{item.muscle}}</text><text class="mini-tag">{{item.equipment}}</text><text class="level-tag">{{item.level}}</text></view>
            </view>
          </view>
          <text class="row-arrow">›</text>
        </view>
      </block>
      <view wx:if="{{!filteredExercises.length}}" class="empty-state"><view class="empty-title">没有找到相关动作</view><view class="empty-copy">换个关键词或筛选条件试试</view></view>
    </view>
  </view>

  <bottom-nav active="/pages/training/home" current="/pages/training/list" bind:change="onBottomNav" />
</view>
