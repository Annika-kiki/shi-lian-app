@import "../../styles/common.wxss";

.record-page { background: #f4f1e8; }
.record-body { padding-top: 34rpx; }
.record-header { display: grid; grid-template-columns: 72rpx 1fr 100rpx; align-items: center; }
.record-close { width: 68rpx; height: 68rpx; border: 1rpx solid rgba(23,59,49,.16); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #173b31; font-size: 34rpx; }
.record-heading { text-align: center; }
.record-heading text { color: #9a8065; font-size: 17rpx; font-weight: 700; letter-spacing: 2rpx; }
.record-heading view { margin-top: 3rpx; color: #173b31; font-size: 34rpx; font-weight: 800; }
.elapsed-time { color: #173b31; text-align: right; font-size: 27rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.workout-summary { margin-top: 34rpx; padding: 30rpx; border-radius: 22rpx; background: #173b31; color: #fff; }
.summary-label { color: #afc0b7; font-size: 22rpx; }
.summary-title { margin-top: 12rpx; font-size: 40rpx; font-weight: 800; }
.progress-line { height: 7rpx; margin-top: 30rpx; border-radius: 7rpx; overflow: hidden; background: rgba(255,255,255,.15); }
.progress-fill { height: 100%; border-radius: 7rpx; background: #d8ef9f; transition: width .25s; }
.summary-foot { margin-top: 14rpx; display: flex; justify-content: space-between; color: #afc0b7; font-size: 21rpx; }
.table-head, .set-row { display: grid; grid-template-columns: 70rpx 1fr 1fr 76rpx; gap: 14rpx; align-items: center; }
.table-head { margin: 38rpx 0 14rpx; color: #89948f; text-align: center; font-size: 19rpx; font-weight: 700; }
.set-list { border-top: 1rpx solid rgba(23,59,49,.12); }
.set-row { padding: 18rpx 0; border-bottom: 1rpx solid rgba(23,59,49,.12); transition: opacity .2s; }
.set-row-done { opacity: .65; }
.set-index { color: #8e7960; text-align: center; font-size: 24rpx; font-weight: 800; }
.set-input { width: 100%; height: 78rpx; border-radius: 13rpx; background: #fffdf7; color: #173b31; text-align: center; font-size: 30rpx; font-weight: 700; box-sizing: border-box; }
.set-done { width: 66rpx; height: 66rpx; margin: auto; border: 2rpx solid #9baa9f; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 27rpx; }
.set-done.done { border-color: #173b31; background: #173b31; }
.set-tools { margin-top: 26rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.add-set, .rest-timer { min-height: 86rpx; padding: 0 20rpx; border: 1rpx solid rgba(23,59,49,.17); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; color: #173b31; font-size: 24rpx; font-weight: 700; }
.rest-timer { justify-content: space-between; font-variant-numeric: tabular-nums; }
.rest-active { border-color: #c96443; background: #eadbd0; color: #9b472f; }
.record-footer-space { height: 150rpx; }
.record-footer { position: fixed; left: 0; right: 0; bottom: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(244,241,232,.96); }
.finish-button { height: 94rpx; padding: 0 28rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: space-between; background: #173b31; color: #fff; font-size: 29rpx; font-weight: 800; }
