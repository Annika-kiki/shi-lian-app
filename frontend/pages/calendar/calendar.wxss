@import "../../styles/common.wxss";

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 14rpx;
}

.week-row {
  margin-bottom: 18rpx;
  color: var(--muted);
  font-size: 26rpx;
  text-align: center;
}

.day {
  height: 92rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: transparent;
  font-size: 28rpx;
  color: var(--muted);
}

.started {
  color: var(--ink-soft);
}

.rest-day {
  background: rgba(201, 234, 199, 0.7);
}

.marked,
.training-day {
  background: var(--green-soft);
}

.day-dot {
  height: 16rpx;
  line-height: 16rpx;
  color: var(--green);
}

.selected {
  border: 4rpx solid var(--green);
}

.summary-line {
  padding-top: 18rpx;
}

.mini-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 142rpx;
}

.mini-summary .item-title {
  font-size: 28rpx;
  line-height: 1.35;
}

.record-row {
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.record-row:first-of-type {
  border-top: 0;
}

.record-title {
  font-size: 30rpx;
}

.empty-line {
  padding: 20rpx 0 4rpx;
  color: var(--muted);
  font-size: 26rpx;
}
