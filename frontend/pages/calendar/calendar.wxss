@import "../../styles/common.wxss";

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 14rpx;
}

.week-row {
  margin-bottom: 18rpx;
  color: #7b8e84;
  font-size: 26rpx;
  text-align: center;
}

.day {
  height: 92rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: transparent;
  font-size: 28rpx;
  color: #a3b0aa;
}

.started {
  color: #53665d;
}

.rest-day {
  background: rgba(223, 238, 221, 0.36);
}

.marked,
.training-day {
  background: #dfeedd;
}

.day-dot {
  height: 16rpx;
  line-height: 16rpx;
  color: #4f8168;
}

.selected {
  border: 4rpx solid #4f8168;
}

.summary-line {
  padding-top: 18rpx;
}

.mini-summary {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 142rpx;
}

.mini-summary .item-title {
  font-size: 28rpx;
  line-height: 1.35;
}

.record-row {
  padding: 22rpx 0;
  border-top: 1rpx solid #eee7d8;
}

.record-row:first-of-type {
  border-top: 0;
}

.record-title {
  font-size: 30rpx;
}

.empty-line {
  padding: 20rpx 0 4rpx;
  color: #7b8e84;
  font-size: 26rpx;
}
