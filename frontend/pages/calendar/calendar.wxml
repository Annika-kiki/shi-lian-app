<view class="page">
  <view class="page-body">
    <view class="header">
      <view class="icon-btn">‹</view>
      <text class="header-title">2026 年 8 月</text>
      <view class="icon-btn">›</view>
    </view>

    <view class="week-row">
      <text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text>
    </view>

    <view class="calendar-grid">
      <block wx:for="{{cells}}" wx:key="index">
        <view class="day {{item.marked ? 'marked' : ''}} {{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="selectDay">
          <text wx:if="{{item.day}}">{{item.day}}</text>
          <text wx:if="{{item.marked}}">•</text>
        </view>
      </block>
    </view>

    <view class="spacer-24"></view>
    <view class="card card-soft card-pad">
      <view class="muted">{{selectedDay}}</view>
      <view class="item-title">{{selectedTitle}}</view>
      <view class="item-meta">{{selectedNote}}</view>
    </view>

    <view class="spacer-24"></view>
    <view class="card card-pad">
      <view class="row-between">
        <text class="section-title">本月概览</text>
        <text class="muted">{{overview.count}} 次训练</text>
      </view>
      <view class="row-between summary-line">
        <text>总时长</text>
        <text class="item-title">{{overview.duration}} 分钟</text>
      </view>
      <view class="row-between summary-line">
        <text>训练最多</text>
        <text class="item-title">{{overview.top}}</text>
      </view>
    </view>

    <view class="spacer-24"></view>
    <view class="list-item" wx:for="{{history}}" wx:key="day" bindtap="openDetail">
      <view class="row-between">
        <view class="item-title">{{item.day}}  {{item.name}}</view>
        <view class="item-title">{{item.duration}} ></view>
      </view>
    </view>
  </view>

  <bottom-nav active="/pages/calendar/calendar" current="/pages/calendar/calendar" bind:change="onBottomNav" />
</view>
