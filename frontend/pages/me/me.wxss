@import "../../styles/common.wxss";

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.profile-main {
  flex: 1;
}

.profile-arrow {
  font-size: 56rpx;
  color: var(--green-dark);
}

.menu {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}
