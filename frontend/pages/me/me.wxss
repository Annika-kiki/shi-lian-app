@import "../../styles/common.wxss";

.profile-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  border: 0;
  background: var(--mint);
  box-shadow: none;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 38rpx;
  background: var(--green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(56, 142, 60, 0.2);
}

.profile-main {
  flex: 1;
}

.profile-arrow {
  font-size: 52rpx;
  color: var(--green-dark);
}

.menu {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  min-height: 84rpx;
}
