@import "../../styles/common.wxss";

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
  transform: rotate(-8deg);
}

.brand-name {
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--ink);
}

.overview-card {
  padding-bottom: 24rpx;
  border: 0;
}

.overview-grid {
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  margin-top: 26rpx;
}

.calorie-ring {
  width: 232rpx;
  height: 232rpx;
  padding: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background 360ms cubic-bezier(0.2, 0, 0, 1);
}

.ring-center {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--green-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ring-value {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--ink);
}

.ring-label {
  margin-top: 2rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.overview-copy {
  min-width: 0;
}

.overview-copy .section-title {
  margin-bottom: 12rpx;
}

.overview-copy .item-title {
  font-size: 34rpx;
}

.overview-line {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(47, 125, 61, 0.16);
  color: var(--muted);
  font-size: 24rpx;
}

.macro {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
  margin-bottom: 18rpx;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.score-card {
  border-color: var(--mint-strong);
}

.score-number {
  margin-top: 10rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--ink);
}

.score-unit {
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 500;
}

.score-side {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: var(--green-dark);
  font-size: 26rpx;
  text-align: right;
}

.tip-box {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--mint);
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.55;
}

.quick-input {
  height: 92rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  box-sizing: border-box;
  font-size: 28rpx;
}

.overview-card {
  background: var(--green-soft);
  border-radius: 32rpx;
}

.calorie-ring {
  background: conic-gradient(from -90deg, var(--green) 0deg, #b8dc73 0deg 360deg);
}

.score-card {
  background: var(--surface);
  border-color: var(--line);
}

.tip-box {
  background: var(--surface-low);
  border: 1rpx solid var(--line);
}

.home-header {
  align-items: center;
  margin-bottom: 22rpx;
}

.home-header .header-title {
  margin-top: 5rpx;
  font-size: 40rpx;
}

.header-bell {
  position: relative;
  width: 38rpx;
  height: 44rpx;
  margin: 0 12rpx;
  flex: none;
}

.header-bell::before {
  position: absolute;
  left: 7rpx;
  top: 3rpx;
  width: 24rpx;
  height: 30rpx;
  content: "";
  border: 3rpx solid var(--ink-soft);
  border-radius: 14rpx 14rpx 8rpx 8rpx;
  box-sizing: border-box;
}

.header-bell::after {
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  width: 30rpx;
  height: 4rpx;
  content: "";
  background: var(--ink-soft);
  border-radius: 4rpx;
}

.overview-card {
  padding: 26rpx 22rpx 16rpx;
  background: var(--surface);
}

.overview-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 176rpx;
  padding: 4rpx 4rpx 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.calorie-ring {
  flex: none;
  width: 176rpx;
  height: 176rpx;
  padding: 12rpx;
}

.ring-center {
  background: var(--surface);
}

.ring-value {
  font-size: 38rpx;
  color: var(--green-dark);
}

.calorie-total {
  margin-top: 12rpx;
  font-size: 46rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--ink);
  white-space: nowrap;
}

.calorie-target {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 500;
}

.macro-list {
  padding-top: 8rpx;
}

.macro {
  display: grid;
  grid-template-columns: 144rpx minmax(72rpx, 1fr) 118rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 62rpx;
  margin: 0;
  font-size: 23rpx;
}

.macro-name {
  white-space: nowrap;
}

.macro-target {
  display: none;
}

.macro-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
}

.macro-track .fill {
  background: var(--green);
}

.macro-value {
  color: var(--ink-soft);
  font-size: 20rpx;
  text-align: right;
  white-space: nowrap;
}

.home-action {
  gap: 10rpx;
  min-height: 82rpx;
}

.action-symbol {
  font-size: 32rpx;
  font-weight: 600;
}

.meal-kcal {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.meal-kcal text {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 400;
}

.meal-kcal .meal-add {
  color: var(--green-dark);
  font-size: 34rpx;
}
