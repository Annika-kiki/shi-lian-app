@import "../../styles/common.wxss";

.macro {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #e2ddd0;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8168;
}
