@import "../../styles/common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.back-btn {
  width: auto;
  min-width: 96rpx;
  padding: 0 20rpx;
  justify-content: flex-start;
  font-size: 30rpx;
  color: var(--green-dark);
}

.list-item {
  border-left: 8rpx solid var(--green);
}

.list-item .item-title {
  font-size: 34rpx;
}
