@import "../../styles/common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.hero {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft);
  border-color: var(--mint-strong);
}

.hero-mark {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  font-size: 72rpx;
}

.ingredient,
.step {
  font-size: 28rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.step:last-child,
.ingredient:last-child {
  border-bottom: 0;
}
