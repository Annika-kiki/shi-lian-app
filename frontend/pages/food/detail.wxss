@import "../../styles/common.wxss";

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.hero {
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mint);
  border-color: var(--mint-strong);
  box-shadow: none;
}

.hero-mark {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green);
  color: #fff;
  font-size: 54rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 28rpx rgba(56, 142, 60, 0.2);
}

.ingredient,
.step {
  font-size: 28rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
  line-height: 1.45;
}

.step:last-child,
.ingredient:last-child {
  border-bottom: 0;
}
