@import "../../styles/common.wxss";

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.analysis-card {
  border-color: var(--mint-strong);
}

.analysis-mark {
  min-width: 64rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface);
  box-sizing: border-box;
  font-size: 28rpx;
}

.analysis-card {
  background: var(--mint);
}

.analysis-card .item-title {
  color: var(--green-dark);
  font-size: 44rpx;
}

.analysis-mark {
  background: var(--green);
  color: #fff;
}
