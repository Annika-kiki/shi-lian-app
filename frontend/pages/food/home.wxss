@import "../../styles/common.wxss";

.intake-card {
  padding: 26rpx 24rpx 20rpx;
}

.intake-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.intake-total {
  margin-top: 12rpx;
  font-size: 36rpx;
  white-space: nowrap;
}

.intake-total .muted {
  font-size: 22rpx;
  font-weight: 500;
}

.remain-total {
  min-width: 136rpx;
  font-size: 38rpx;
  line-height: 1.05;
  text-align: right;
  font-weight: 800;
  color: var(--green-dark);
}

.remain-total text {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}

.intake-bar {
  height: 12rpx;
  margin-top: 20rpx;
}

.intake-foot {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.analysis-card {
  background: var(--surface);
}

.analysis-card .item-title {
  margin-top: 8rpx;
  font-size: 36rpx;
}

.analysis-card .item-meta {
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.analysis-mark {
  min-width: 74rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 23rpx;
  font-weight: 700;
}

.quick-input {
  width: 100%;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--surface-low);
  box-sizing: border-box;
  font-size: 26rpx;
}

.generate-entry {
  min-height: 104rpx;
  justify-content: flex-start;
  gap: 18rpx;
  padding: 14rpx 22rpx;
  border-color: var(--mint-strong);
  background: var(--green-soft);
  text-align: left;
}

.generate-mark {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface);
  color: var(--green-dark);
  font-size: 36rpx;
  font-weight: 500;
}

.generate-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.generate-copy text + text {
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 400;
}

.generate-arrow {
  color: var(--green-dark);
  font-size: 40rpx;
  line-height: 1;
}

.meal-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  white-space: nowrap;
}

.meal-add {
  color: var(--green-dark);
  font-size: 34rpx;
}

.food-calendar {
  color: var(--green-dark);
  font-size: 32rpx;
}

.page-body > .row-between .section-title {
  margin-bottom: 0;
}
