@import "../../styles/common.wxss";

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background: #e2ddd0;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8168;
}

.analysis-card {
  border-color: #b9cbbb;
}

.analysis-mark {
  min-width: 64rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e4eee4;
  color: #4f8168;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #ddd5c3;
  border-radius: 20rpx;
  background: #fffdf8;
  box-sizing: border-box;
  font-size: 28rpx;
}
