page {
  --ink: #172019;
  --ink-soft: #3f4a41;
  --muted: #707970;
  --green: #2f7d3d;
  --green-dark: #1e612c;
  --green-soft: #c9eac7;
  --mint: #eaf7e8;
  --mint-strong: #b8e3b5;
  --yellow: #c98819;
  --orange: #b85d2b;
  --canvas: #f8fbf6;
  --surface: #fdfdf9;
  --surface-low: #edf5eb;
  --surface-high: #e2eee0;
  --surface-variant: #dce8da;
  --line: #d5e1d3;
  --outline: #737c73;
  --outline-variant: #b9c8b8;
  --shadow: rgba(25, 51, 29, 0.08);
  --scrim: rgba(17, 33, 20, 0.34);
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  background: var(--canvas);
  box-sizing: border-box;
}

.page-body {
  padding: 28rpx 28rpx 176rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: 0;
  color: var(--ink);
}

.header-subtitle {
  font-size: 24rpx;
  color: var(--muted);
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-high);
  border: 2rpx solid var(--outline-variant);
  color: var(--ink-soft);
  font-size: 32rpx;
  box-sizing: border-box;
}

.back-btn {
  border: 0;
  background: transparent;
  color: var(--green-dark);
  font-size: 46rpx;
  font-weight: 400;
}

.card {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 26rpx var(--shadow);
}

.card-soft {
  background: var(--mint);
  border-color: transparent;
  box-shadow: none;
}

.card-pad {
  padding: 28rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 18rpx;
}

.muted {
  color: var(--muted);
}

.row {
  display: flex;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 26rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.pill-active {
  background: var(--green);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(47, 125, 61, 0.18);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(47, 125, 61, 0.2);
  box-sizing: border-box;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--outline-variant);
  color: var(--green-dark);
  box-shadow: none;
}

.btn-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 26rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 28rpx var(--shadow);
}

.item-title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--ink);
}

.item-meta {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: var(--muted);
}

.spacer-24 {
  height: 22rpx;
}

.spacer-32 {
  height: 30rpx;
}

.spacer-40 {
  height: 38rpx;
}

.footer-space {
  height: 170rpx;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.empty-line {
  padding: 24rpx 0 4rpx;
  color: var(--muted);
  font-size: 26rpx;
}

button {
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  font-family: inherit;
  background: transparent;
}

.btn,
.pill,
.list-item,
.icon-btn {
  transition: transform 180ms cubic-bezier(0.2, 0, 0, 1), box-shadow 240ms cubic-bezier(0.2, 0, 0, 1), background-color 180ms ease, border-color 180ms ease;
}

.btn:active,
.pill:active,
.list-item:active,
.icon-btn:active {
  transform: scale(0.97);
}

.btn:active {
  box-shadow: 0 6rpx 14rpx rgba(47, 125, 61, 0.12);
}

input,
textarea {
  color: var(--ink);
  font-family: inherit;
  box-sizing: border-box;
}

.input-box:focus,
.quick-input:focus,
.search-box:focus,
.cardio-input:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 4rpx rgba(47, 125, 61, 0.14);
}
