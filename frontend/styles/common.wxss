page {
  --ink: #173b2c;
  --ink-soft: #496459;
  --muted: #7c9084;
  --green: #16b981;
  --green-dark: #0a4f3c;
  --green-soft: #e2f3c9;
  --mint: #eef8dc;
  --mint-strong: #c3e875;
  --yellow: #f6bd51;
  --orange: #ef9366;
  --canvas: #f3f8e9;
  --surface: #fffefa;
  --surface-low: #f7fbf0;
  --surface-high: #dff2bf;
  --surface-variant: #e5ebdf;
  --line: #dce8d4;
  --outline: #8aa095;
  --outline-variant: #b8cbb8;
  --shadow: rgba(23, 59, 44, 0.06);
  --shadow-strong: rgba(23, 59, 44, 0.14);
  --scrim: rgba(19, 34, 21, 0.42);
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  background: var(--canvas);
  box-sizing: border-box;
}

.page-body {
  padding: 26rpx 28rpx 196rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: 0;
  color: var(--ink);
}

.header-subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.icon-btn {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-high);
  border: 2rpx solid transparent;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.back-btn {
  border: 0;
  background: transparent;
  color: var(--green-dark);
  font-size: 48rpx;
  font-weight: 400;
}

.card {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 5rpx 18rpx var(--shadow);
}

.card-soft {
  background: var(--mint);
  border-color: transparent;
  box-shadow: none;
}

.card-pad {
  padding: 28rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 18rpx;
}

.muted {
  color: var(--muted);
}

.row {
  display: flex;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 25rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.pill-active {
  background: var(--green);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(22, 185, 129, 0.2);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 24rpx;
  background: var(--green);
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: 0 12rpx 24rpx rgba(22, 185, 129, 0.18);
  box-sizing: border-box;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--outline-variant);
  color: var(--green-dark);
  box-shadow: none;
}

.btn-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-item {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 26rpx;
  box-sizing: border-box;
  box-shadow: 0 5rpx 18rpx var(--shadow);
}

.item-title {
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--ink);
}

.item-meta {
  margin-top: 9rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.spacer-24 {
  height: 22rpx;
}

.spacer-32 {
  height: 30rpx;
}

.spacer-40 {
  height: 38rpx;
}

.footer-space {
  height: 170rpx;
}

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.empty-line {
  padding: 24rpx 0 4rpx;
  color: var(--muted);
  font-size: 26rpx;
}

button {
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  font-family: inherit;
  background: transparent;
}

/* Shared reference style: soft health dashboard surfaces and quiet controls. */
.page-body > .card,
.page-body > .list-item {
  position: relative;
}

.page-body > .card-soft {
  background: var(--mint);
  border-color: transparent;
}

.card .section-title,
.list-item .section-title {
  letter-spacing: 0;
}

.quick-input,
.input-box,
.search-box,
.cardio-input {
  border-color: var(--line);
  background: var(--surface);
}

.btn,
.pill,
.list-item,
.icon-btn {
  transition: transform 180ms cubic-bezier(0.2, 0, 0, 1), box-shadow 240ms cubic-bezier(0.2, 0, 0, 1), background-color 180ms ease, border-color 180ms ease;
}

.btn:active,
.pill:active,
.list-item:active,
.icon-btn:active {
  transform: scale(0.97);
}

.btn:active {
  box-shadow: 0 6rpx 14rpx rgba(56, 142, 60, 0.12);
}

input,
textarea {
  color: var(--ink);
  font-family: inherit;
  box-sizing: border-box;
  outline: none;
}

.input-box:focus,
.quick-input:focus,
.search-box:focus,
.cardio-input:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 4rpx rgba(56, 142, 60, 0.14);
}
