page {
  --ink: #202923;
  --ink-soft: #46534a;
  --muted: #7d8980;
  --green: #4e9d43;
  --green-dark: #347a35;
  --green-soft: #eaf4e6;
  --mint: #f1f7ee;
  --mint-strong: #cfe5c8;
  --yellow: #d7ac43;
  --orange: #d77b54;
  --canvas: #f3f6f2;
  --surface: #ffffff;
  --surface-low: #f8faf7;
  --surface-high: #e7f1e4;
  --surface-variant: #e5eae3;
  --line: #e5eae3;
  --outline: #8b978e;
  --outline-variant: #c7d1c8;
  --shadow: rgba(28, 47, 31, 0.035);
  --shadow-strong: rgba(28, 47, 31, 0.11);
  --scrim: rgba(20, 31, 23, 0.42);
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 27rpx;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  background: var(--canvas);
  box-sizing: border-box;
}

.page-body {
  padding: 24rpx 28rpx 184rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: 0;
  color: var(--ink);
}

.header-subtitle {
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-high);
  border: 2rpx solid transparent;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.header-action-spacer {
  width: 64rpx;
  height: 64rpx;
  flex: none;
}

.back-btn {
  border: 0;
  background: transparent;
  color: var(--green-dark);
  font-size: 48rpx;
  font-weight: 400;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx var(--shadow);
}

.card-soft {
  background: var(--mint);
  border-color: transparent;
  box-shadow: none;
}

.card-pad {
  padding: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.muted {
  color: var(--muted);
}

.row {
  display: flex;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--green-soft);
  color: var(--green-dark);
  font-size: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.pill-active {
  background: var(--green);
  color: #fff;
  box-shadow: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  border-radius: 16rpx;
  background: var(--green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: 0 6rpx 14rpx rgba(63, 133, 54, 0.12);
  box-sizing: border-box;
}

.btn-outline {
  background: var(--surface);
  border: 1rpx solid var(--green);
  color: var(--green-dark);
  box-shadow: none;
}

.btn-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-item {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 14rpx var(--shadow);
}

.item-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--ink);
}

.item-meta {
  margin-top: 9rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: var(--muted);
}

.spacer-24 {
  height: 22rpx;
}

.spacer-32 {
  height: 30rpx;
}

.spacer-40 {
  height: 38rpx;
}

.footer-space {
  height: 150rpx;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--surface-variant);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.empty-line {
  padding: 24rpx 0 4rpx;
  color: var(--muted);
  font-size: 26rpx;
}

button {
  border-radius: 999rpx;
  margin: 0;
  padding: 0;
  border: 0;
  line-height: normal;
  font-family: inherit;
  background: transparent;
}

/* Shared reference style: soft health dashboard surfaces and quiet controls. */
.page-body > .card,
.page-body > .list-item {
  position: relative;
}

.page-body > .card-soft {
  background: var(--mint);
  border-color: transparent;
}

.card .section-title,
.list-item .section-title {
  letter-spacing: 0;
}

.quick-input,
.input-box,
.search-box,
.cardio-input {
  border-color: var(--line);
  background: var(--surface);
}

.btn,
.pill,
.list-item,
.icon-btn {
  transition: transform 180ms cubic-bezier(0.2, 0, 0, 1), box-shadow 240ms cubic-bezier(0.2, 0, 0, 1), background-color 180ms ease, border-color 180ms ease;
}

.btn:active,
.pill:active,
.list-item:active,
.icon-btn:active {
  transform: scale(0.97);
}

.btn:active {
  box-shadow: 0 3rpx 8rpx rgba(56, 142, 60, 0.1);
}

input,
textarea {
  color: var(--ink);
  font-family: inherit;
  box-sizing: border-box;
  outline: none;
}

.input-box:focus,
.quick-input:focus,
.search-box:focus,
.cardio-input:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 4rpx rgba(56, 142, 60, 0.14);
}
