.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: rgba(253, 253, 249, 0.96);
  border-top: 2rpx solid var(--line);
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 20;
  box-shadow: 0 -8rpx 28rpx var(--shadow);
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
  min-height: 76rpx;
}

.item.active {
  color: var(--green-dark);
}

.icon-wrap {
  width: 50rpx;
  height: 42rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item.active .icon-wrap {
  background: var(--mint-strong);
  color: var(--green-dark);
}

.icon {
  font-size: 28rpx;
  line-height: 1;
}

.label {
  font-size: 22rpx;
  line-height: 1.2;
}
