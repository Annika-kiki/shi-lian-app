.bar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid var(--line);
  border-radius: 30rpx;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 20;
  box-shadow: 0 12rpx 34rpx var(--shadow-strong);
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: var(--muted);
  font-size: 22rpx;
  min-height: 78rpx;
  border-radius: 22rpx;
}

.item.active {
  color: var(--green-dark);
}

.icon-wrap {
  width: 50rpx;
  height: 42rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item.active .icon-wrap {
  background: var(--mint-strong);
  color: var(--green-dark);
}

.icon {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.label {
  font-size: 22rpx;
  line-height: 1.2;
}
