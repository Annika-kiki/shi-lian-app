.bar {
  position: fixed;
  left: 12rpx;
  right: 12rpx;
  bottom: 14rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 6rpx 4rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 20;
  box-shadow: 0 3rpx 14rpx var(--shadow);
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: #89918b;
  font-size: 22rpx;
  min-height: 86rpx;
  border-radius: 16rpx;
}

.item.active {
  color: var(--green-dark);
  background: transparent;
}

.icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  background-color: currentColor;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  mask-repeat: no-repeat;
}

