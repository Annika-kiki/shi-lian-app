.bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: rgba(255, 254, 250, 0.98);
  border: 2rpx solid rgba(220, 232, 212, 0.9);
  border-radius: 28rpx;
  padding: 10rpx 10rpx calc(10rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 20;
  box-shadow: 0 14rpx 36rpx var(--shadow-strong);
}

.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  color: var(--muted);
  font-size: 22rpx;
  min-height: 64rpx;
  border-radius: 20rpx;
}

.item.active {
  color: var(--green-dark);
  background: var(--green-soft);
}

.icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item.active .icon-wrap {
  background: transparent;
  color: var(--green-dark);
}

.icon {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.label {
  display: none;
}
