<view class="bar">
  <block wx:for="{{items}}" wx:key="route">
    <view
      class="item {{active === item.route ? 'active' : ''}}"
      data-route="{{item.route}}"
      bindtap="handleChange"
    >
      <view class="icon-wrap" aria-hidden="true">
        <view class="nav-icon nav-icon-{{item.key}}"></view>
      </view>
      <text class="label">{{item.label}}</text>
    </view>
  </block>
</view>
