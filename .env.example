# SQLite is the default local development database. Replace with a MySQL URL later.
DATABASE_URL=sqlite:///./shi_lian.db
APP_ENV=development
AUTH_MODE=wechat_api
LOG_LEVEL=INFO
CORS_ORIGINS=*
ALLOWED_HOSTS=*
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Generate outside the repository for staging/production. Never commit the value.
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
SENSITIVE_RATE_LIMIT_PER_MINUTE=30
