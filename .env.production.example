APP_ENV=production
LOG_LEVEL=INFO
AUTH_MODE=cloud_headers
# Prefer these Cloud Hosting variables; DATABASE_URL may be used instead.
MYSQL_ADDRESS=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=shi_lian_production
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
CORS_ORIGINS=
