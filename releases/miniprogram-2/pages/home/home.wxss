@import "../../styles/common.wxss";

/* 页面基础设置 */
.page {
  min-height: 100vh;
  background: var(--canvas);
  position: relative;
}

/* 顶部避开手机状态栏，底部留出空间防止内容被挡住 */
.page-body {
  padding-top: calc(env(safe-area-inset-top) + 40rpx) !important;
  padding-bottom: 250rpx !important;
}

/* ============ 页面原有样式 ============ */
.home-header { align-items: center; margin-bottom: 32rpx; }
.home-header .header-title { font-size: 48rpx; font-weight: 800; color: var(--ink); line-height: 1.2; }

.overview-card { padding: 36rpx 28rpx 24rpx; background: var(--surface); border-radius: 32rpx; box-shadow: 0 6rpx 24rpx rgba(28, 47, 31, 0.05); border: 1rpx solid var(--line); }
.overview-top { display: flex; justify-content: space-between; align-items: center; padding-bottom: 28rpx; border-bottom: 1rpx solid var(--line); }
.overview-copy { flex: 1; min-width: 0; }
.overview-copy .muted { font-size: 26rpx; margin-bottom: 12rpx; }
.calorie-total { font-size: 64rpx; font-weight: 800; color: var(--ink); line-height: 1.05; white-space: nowrap; letter-spacing: -1rpx; }
.calorie-target { color: var(--muted); font-size: 26rpx; font-weight: 500; letter-spacing: 0; margin-left: 6rpx; }
.intake-foot { margin-top: 14rpx; font-size: 22rpx; color: var(--muted); }

.calorie-ring { flex: none; width: 200rpx; height: 200rpx; padding: 14rpx; border-radius: 50%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin-left: 24rpx; transition: background 360ms cubic-bezier(0.2, 0, 0.2, 1); }
.ring-center { width: 100%; height: 100%; border-radius: 50%; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.ring-value { font-size: 44rpx; font-weight: 800; color: var(--green-dark); line-height: 1.1; }
.ring-label { color: var(--muted); font-size: 22rpx; line-height: 1.4; }

.macro-list { padding-top: 24rpx; }
.macro { display: grid; grid-template-columns: 170rpx minmax(80rpx, 1fr) 140rpx; align-items: center; gap: 16rpx; min-height: 76rpx; font-size: 26rpx; }
.macro-name { color: var(--ink-soft); font-size: 26rpx; font-weight: 500; white-space: nowrap; }
.macro-track { height: 14rpx; border-radius: 999rpx; background: var(--surface-variant); overflow: hidden; }
.macro-track .fill { height: 100%; border-radius: 999rpx; background: var(--green); transition: width 360ms cubic-bezier(0.2, 0, 0.2, 1); }
.macro-value { color: var(--ink-soft); font-size: 23rpx; text-align: right; white-space: nowrap; }

.btn-row { margin-top: 32rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; }
.home-action { gap: 12rpx; min-height: 100rpx; font-size: 30rpx; font-weight: 700; }
.action-symbol { font-size: 34rpx; font-weight: 700; }

.list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 16rpx; }
.list-item { padding: 28rpx 26rpx; border-radius: 20rpx; background: var(--surface); border: 1rpx solid var(--line); box-shadow: 0 4rpx 14rpx var(--shadow); }
.list-item .item-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.list-item .item-meta { margin-top: 8rpx; font-size: 24rpx; color: var(--muted); }
.meal-kcal { color: var(--green-dark); font-size: 32rpx; font-weight: 800; white-space: nowrap; }
.meal-kcal text { color: var(--muted); font-size: 22rpx; font-weight: 500; margin-left: 6rpx; }
.meal-kcal .meal-add { color: var(--green-dark); font-size: 40rpx; font-weight: 400; margin-left: 0; }

.section-title { font-size: 34rpx; font-weight: 800; color: var(--ink); }
.row-between .muted { font-size: 26rpx; }
.quick-card, .insight-card { margin-bottom: 24rpx; }
.quick-input { padding: 24rpx 0; height: 72rpx; }
.meal-picker { padding: 16rpx 0; color: var(--green-dark); }
.load-error { padding: 20rpx; color: #a13a2d; }
